{
  "expo": {
    "name": "AutoCard",
    "slug": "autocard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0177E3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aguautomotive.autocard"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0177E3"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.aguautomotive.autocard",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to upload bills.",
          "cameraPermission": "The app needs access to your camera to take photos of bills."
        }
      ]
    ]
  }
}
