# Firebase Configuration Template
# Copy this to src/config/firebase.js and fill in your values

# Get these values from Firebase Console:
# 1. Go to https://console.firebase.google.com
# 2. Select your project
# 3. Click the gear icon → Project Settings
# 4. Scroll to "Your apps" → Web app → Config

FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Example (DO NOT USE THESE VALUES):
# FIREBASE_API_KEY=AIzaSyBxxxxxxxxxxxxxxxxxxxxxxxxx
# FIREBASE_AUTH_DOMAIN=autocard-12345.firebaseapp.com
# FIREBASE_PROJECT_ID=autocard-12345
# FIREBASE_STORAGE_BUCKET=autocard-12345.appspot.com
# FIREBASE_MESSAGING_SENDER_ID=123456789012
# FIREBASE_APP_ID=1:123456789012:web:abcdef123456
